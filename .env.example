# =============================================================================
# Cloudflare + Caddy reverse proxy — configuration
# Copy to `.env`, fill in the values, then run `docker compose up`.
# =============================================================================

# Your Cloudflare zone apex (the root domain in Cloudflare). REQUIRED.
CF_DOMAIN=example.com

# Cloudflare API token. REQUIRED (unless CF_OFFLINE=true).
# Create at https://dash.cloudflare.com/profile/api-tokens with permissions:
#   Zone : Zone                 : Read
#   Zone : DNS                  : Edit
#   Zone : Zone Settings        : Edit   (needed for the SSL/TLS mode step)
#   Zone : SSL and Certificates : Edit
# scoped to the zone above.
CF_API_TOKEN=

# Public IP of this server for the DNS A record(s).
# Leave blank to auto-detect via an external IP-echo service.
SERVER_IP=

# ---- Optional tuning (defaults shown) ---------------------------------------

# Proxy DNS records through Cloudflare (orange cloud). Keep true for Origin CA.
# DNS_PROXIED=true

# SSL/TLS mode: off | flexible | full | strict   (strict = Full (strict)).
# SSL_MODE=strict

# Also manage the apex (root) A record. Off by default so an existing root
# website is never overwritten — only the wildcard *.<domain> is managed.
# MANAGE_APEX=false

# Origin certificate validity in days. One of: 7 30 90 365 730 1095 5475.
# CERT_VALIDITY_DAYS=5475

# Hostnames on the origin certificate (comma-separated).
# Defaults to "<CF_DOMAIN>,*.<CF_DOMAIN>".
# CERT_HOSTNAMES=

# Regenerate the certificate when it expires within this many days.
# RENEW_BEFORE_DAYS=30

# Offline / local-dev mode: skip ALL Cloudflare calls and generate a
# self-signed certificate instead. Used by CI and for local testing.
# CF_OFFLINE=false
